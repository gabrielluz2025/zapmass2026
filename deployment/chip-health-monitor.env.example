# Copie para /opt/zapmass/data/chip-health-monitor.env (chmod 600)
# e preencha os valores. Nunca commite o arquivo real com segredos.

# URL do summary (default: API local na VPS — loopback não exige JWT)
# ZAPMASS_CHIP_HEALTH_API_URL=http://127.0.0.1:3001/api/chip-health/summary

# Opção A (recomendada): chave estática — MESMO valor em /opt/zapmass/.env:
#   ZAPMASS_INTERNAL_MONITOR_KEY=sua_chave_longa_aleatoria
ZAPMASS_INTERNAL_MONITOR_KEY=

# Opção B: loopback puro (sem header) — funciona se houver um único tenant na VPS.
# Se multi-tenant, defina também no .env do backend:
#   ZAPMASS_MONITOR_TENANT_UID=firebase-uid-do-dono

# Opção C (legado): JWT Firebase — expira ~1h, evite no cron
# ZAPMASS_MONITOR_BEARER_TOKEN=

# Discord (opcional)
DISCORD_WEBHOOK_URL=

# Telegram (opcional — use bot + chat_id)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Limiares de alerta (opcional)
# CHIP_HEALTH_CRITICAL_PLUS_THROTTLED=3
# CHIP_HEALTH_AVG_SCORE_WARN=55
# CHIP_HEALTH_ALERT_COOLDOWN_MIN=60
