# Homologação ZapMass — copie para homolog/.env na VPS (/opt/zapmass/homolog/.env)
# Setup: sudo bash deployment/setup-homolog.sh

NODE_ENV=production
ZAPMASS_ENV=homolog

# Portas locais (host)
HOMOLOG_HOST_PORT=3200
HOMOLOG_EVOLUTION_PORT=8082

# Domínio público
HOMOLOG_PUBLIC_URL=https://homolog.zap-mass.com
HOMOLOG_ALLOWED_ORIGINS=https://homolog.zap-mass.com
ZAPMASS_HOMOLOG_WEBHOOK_URL=https://homolog.zap-mass.com/webhook/evolution

# Postgres (mesmo container da stack principal)
POSTGRES_PASSWORD=SUBSTITUA_PELO_MESMO_DA_VPS
HOMOLOG_DATABASE_URL=postgresql://postgres:SUBSTITUA@postgres:5432/zapmass_homolog

# Redis DB 14 reservado para homolog (0=stack prod, 1=Evolution, 2+=clientes)
HOMOLOG_REDIS_URL=redis://redis:6379/14

# JWT exclusivo — gere com: openssl rand -hex 32
HOMOLOG_JWT_SECRET=SUBSTITUA_GERE_NOVO_SECRET

# Evolution Go homolog (isolado de produção)
EVOLUTION_GO_KEY_HOMOLOG=zapmass-homolog-key-2026

# Auth VPS
ZAPMASS_AUTH_PROVIDER=vps
ZAPMASS_DATA_PROVIDER=vps
VITE_USE_VPS_AUTH=true
VITE_USE_VPS_DATA=true
VITE_ENFORCE_SUBSCRIPTION=false

# Mercado Pago SANDBOX (TEST-) — nunca use token APP_USR- de produção aqui
# HOMOLOG_MERCADOPAGO_ACCESS_TOKEN=TEST-...
# HOMOLOG_MERCADOPAGO_BACK_URL=https://homolog.zap-mass.com
# HOMOLOG_MERCADOPAGO_WEBHOOK_SECRET=
HOMOLOG_MERCADOPAGO_WEBHOOK_ALLOW_UNSIGNED=true

# Admins que podem logar em homolog (emails separados ou os mesmos da equipe)
# HOMOLOG_ADMIN_EMAILS=voce@empresa.com

# Rede Docker partilhada com postgres/redis da stack principal
ZAPMASS_SHARED_NETWORK=zapmass_default

# Build front homolog
VITE_ZAPMASS_ENV=homolog
